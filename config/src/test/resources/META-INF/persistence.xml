<persistence xmlns="http://java.sun.com/xml/ns/persistence" version="1.0">
    <persistence-unit name="defaultConfigurerJpaTestEventStore" transaction-type="RESOURCE_LOCAL">
        <class>org.sophonhq.sophon.eventsourcing.eventstore.jpa.DomainEventEntry</class>
        <class>org.sophonhq.sophon.eventsourcing.eventstore.jpa.SnapshotEventEntry</class>
        <class>org.sophonhq.sophon.modelling.saga.repository.jpa.AssociationValueEntry</class>
        <class>org.sophonhq.sophon.modelling.saga.repository.jpa.SagaEntry</class>
        <properties>
            <property name="hibernate.connection.url" value="jdbc:hsqldb:mem:sophontest"/>
            <property name="hibernate.hbm2ddl.auto" value="create-drop"/>
        </properties>
    </persistence-unit>
</persistence>
